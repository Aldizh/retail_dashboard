# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name
ATLAS_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/retail_dashboard"

# JWT Secret for token signing (use a strong random string in production)
JWT_SECRET="your-secret-key-change-in-production"

# Server port
PORT=5001

# Currency conversion API key (from https://currencyapi.com or similar)
CURRENCY_API_KEY="your-currency-api-key"

# Optional: Test database URI (for testing without main database)
TEST_DB_URI="mongodb+srv://TEST_USER:TEST_PASSWORD@cluster.mongodb.net/retail_dashboard_test"
